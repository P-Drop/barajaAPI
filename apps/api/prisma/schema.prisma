generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Suit {
  OROS
  COPAS
  ESPADAS
  BASTOS
}

model Card {
  id      Int     @id @default(autoincrement())
  value   Int?
  suit    Suit?
  isJoker Boolean @default(false)
  name    String

  @@unique([suit, value])
}

model User {
  id                 String   @id @default(uuid())
  nickname           String
  nicknameNormalized String   @unique
  passwordHash       String
  avatar             String
  stars              Int      @default(0)
  totalPlaySeconds   Int      @default(0)
  achievements       String[] @default([])
  createdAt          DateTime @default(now())
  isActive           Boolean  @default(true)
}
