# Entorno
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Puerto del servidor
PORT=3000

# Origen permitido para CORS: '*' (abierto) o lista separada por comas
# En producción: CORS_ORIGIN=https://baraja.pedrorincon.dev
CORS_ORIGIN=*

# Base de Datos
DB_USER=baraja
DB_PASSWORD=baraja
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baraja
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Producción (Supabase, Session mode — IPv4, sirve para app + migraciones):
# connection_limit por debajo del techo del pooler; pool_timeout bajo = falla rápido
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=3

# Rate limiting (defaults: 100 peticiones / 15 min)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Login Auth Rate limit
# AUTH_RATE_LIMIT_MAX=10

# Error tracking (Sentry) — DSN del proyecto baraja-api; vacío = deshabilitado
# SENTRY_DSN=

### SOLITARIO ORDA

# TTL abandono automático
MATCH_TTL_MINUTES=15

# Rate limiting de partidas (ventana propia, NO comparte con RATE_LIMIT_WINDOW_MS)
# Ritmo de juego medido: p50 23,5 mov/min - p90 29 - max 42
# Dos capas: por IP antes de auth (escudo) y por jugador tras auth (justicia)
# MATCH_RATE_LIMIT_WINDOW_MS=60000
# MATCH_RATE_LIMIT_MAX=120      # por jugador
# MATCH_IP_RATE_LIMIT_MAX=300   # por IP
