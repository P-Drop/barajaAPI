# Entorno
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Puerto del servidor
PORT=3000

# Origen permitido para CORS: '*' (abierto) o lista separada por comas
# En producción: CORS_ORIGIN=https://baraja.pedrorincon.dev
CORS_ORIGIN=*

# Base de Datos
DB_USER=baraja
DB_PASSWORD=baraja
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baraja
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Producción (Supabase, Session mode — IPv4, sirve para app + migraciones):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# Rate limiting (defaults: 100 peticiones / 15 min)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Login Auth Rate limit
# AUTH_RATE_LIMIT_MAX=10

# Error tracking (Sentry) — DSN del proyecto baraja-api; vacío = deshabilitado
# SENTRY_DSN=

### SOLITARIO ORDA

# TTL abandono automático
MATCH_TTL_MINUTES=15
