# Entorno
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Puerto del servidor
PORT=3000

# Origen permitido para CORS (producción: URL del frontend)
CORS_ORIGIN=*

# Base de Datos
DB_USER=baraja
DB_PASSWORD=baraja
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baraja
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Producción (Supabase, Session mode — IPv4, sirve para app + migraciones):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
