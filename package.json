{
  "name": "barajaapi",
  "version": "1.3.0",
  "description": "API REST de la baraja española",
  "main": "index.js",
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:contract": "npm run gen:openapi -w api && npm run gen --prefix tools/openapi-gen",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-Drop/barajaAPI.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/P-Drop/barajaAPI/issues"
  },
  "homepage": "https://github.com/P-Drop/barajaAPI#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.1": true,
    "@scarf/scarf@1.4.0": true,
    "@sentry/cli@2.58.6": true,
    "argon2@0.44.0": true
  }
}
